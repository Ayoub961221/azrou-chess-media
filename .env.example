# ─────────────────────────────────────────────────────────────
#  أسماء متغيّرات البيئة فقط — لا تضع أي قيم هنا.
#  انسخ هذا الملف إلى .env (المستثنى من Git) واملأ القيم.
# ─────────────────────────────────────────────────────────────

# Cloudflare R2 (أسرار — تُضبط فقط في Netlify: Site settings ← Environment variables)
R2_ACCOUNT_ID=
R2_KEY=
R2_SECRET=
R2_PUBLIC_URL=
R2_BUCKET=images

# Firebase (المفتاح الويب عام by design، لكنه يُقرأ من البيئة)
FIREBASE_WEB_API_KEY=

# بريد(ات) الأدمن المسموح بالرفع والحذف — مفصولة بفواصل
ADMIN_EMAILS=
# معرّفات UID إضافية اختيارية
ADMIN_UIDS=
